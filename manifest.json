{
  "manifest_version": 3,
  "name": "Twitch Custom Themes",
  "version": "1.0.0",
  "description": "Полная кастомизация Twitch: 20+ предустановленных тем, свои фоны/гифки в чате и на сайте, редактор с live-превью.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "*://*.twitch.tv/*"
  ],
  "action": {
    "default_title": "Twitch Custom Themes",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.twitch.tv/*"],
      "js": ["lib/theme-engine.js", "themes/presets.js", "content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
